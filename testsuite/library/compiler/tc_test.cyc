          .args = NULL, 
          .c_varargs = false,
          .cyc_varargs = NULL,
          .qual_bnd = NULL,
          .attributes = NULL,
          .checks_clause = NULL,
          .checks_assn = NULL,
          .requires_clause = NULL,
          .requires_assn = NULL,
          .ensures_clause = NULL,
          .ensures_assn = NULL,
          .throws_clause = NULL,
          .throws_assn = NULL,
          .return_value = NULL,
          .arg_vardecls = NULL,
          .effconstr = NULL
      };
      
      fndecl_t fd = new Fndecl {
          .sc = Public,
          .is_inline = false,
          .name = name,
          .body = ret,
          .i = info,
          .cached_type = NULL,
          .param_vardecls = new Opt(NULL),
