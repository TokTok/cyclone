  }

  void test_tc_typedef_attribute() {
      tenv_t te = Tcenv::tc_init();
      tc_context_t ctx = Tc::tc_init();
      qvar_t name = mk_qvar("aligned_int");
      
      // typedef int aligned_int __attribute__((aligned(8)));
      typedefdecl_t td = new Typedefdecl {
          .name = name,
          .tq = empty_tqual(0),
          .tvs = NULL,
          .kind = NULL,
          .defn = int_type(Signed, Int_sz),
          .atts = new List(new Absyn::Aligned_att(int_exp(Signed, 8, 0)), NULL), // ALIGNED
          .extern_c = false
      };
      
      tc(ctx, te, false, new List(new_decl(new Typedef_d(td), 0), NULL));
      
      try {
          lookup_typedefdecl(te, 0, name);
          CT_OK();
      } catch {
          case &Dict::Absent:
              CT_FAILM("Typedef with attribute should be in environment");
      }
  }

