  void test_tc_main_valid_args() {
      tenv_t te = Tcenv::tc_init();
      tc_context_t ctx = Tc::tc_init();
      qvar_t name = mk_global_qvar("main");
      
      // Arg: int argc
      vardecl_t arg = new_vardecl(0, mk_qvar("argc"), int_type(Signed, Int_sz), NULL, NULL);

      struct FnInfo info = {
          .tvars = NULL,
          .effect = NULL,
          .ret_tqual = empty_tqual(0),
          .ret_type = int_type(Signed, Int_sz),
          .args = new List(new $((var_opt_t)NULL, empty_tqual(0), int_type(Signed, Int_sz)), NULL),
          .c_varargs = false,
          .cyc_varargs = NULL,
          .qual_bnd = NULL,
          .attributes = NULL,
          .checks_clause = NULL,
          .checks_assn = NULL,
          .requires_clause = NULL,
          .requires_assn = NULL,
          .ensures_clause = NULL,
          .ensures_assn = NULL,
          .throws_clause = NULL,
          .throws_assn = NULL,
          .return_value = NULL,
          .arg_vardecls = new List(arg, NULL),
          .effconstr = NULL
      };
       
      fndecl_t fd = new Fndecl {
          .sc = Public,
          .is_inline = false,
          .name = name,
          .body = new_stmt(new Return_s(int_exp(Signed, 0, 0)), 0),
          .i = info,
          .cached_type = NULL,
          .param_vardecls = new Opt(new List(arg, NULL)),
          .fn_vardecl = NULL,
          .orig_scope = Public,
          .escapes = false
      };
      
      CT_ASSERT(fd->i.args != NULL);
      
      tc(ctx, te, false, new List(new_decl(new Fn_d(fd), 0), NULL));
      CT_OK();
  }

  void test_tc_recursive_struct() {
      tenv_t te = Tcenv::tc_init();
      tc_context_t ctx = Tc::tc_init();
      qvar_t name = mk_qvar("Node");
      
      type_t next_type = star_type(strctq(name), heap_rgn_type, al_qual_type, empty_tqual(0), false_type, false_type);
      
      aggrfield_t f1 = new Aggrfield(new ((string_t)strdup((string_t)"next")), empty_tqual(0), next_type, NULL, NULL, NULL);
      
      struct AggrdeclImpl impl = {
          .exist_vars = NULL,
          .qual_bnd = NULL,
          .fields = new List(f1, NULL),
          .tagged = false,
          .effconstr = NULL
      };
      
      aggrdecl_t ad = new Aggrdecl {
          .kind = StructA,
          .sc = Public,
          .name = name,
          .tvs = NULL,
          .impl = new impl,
          .attributes = NULL,
          .expected_mem_kind = false
      };
      
      tcAggrdecl(ctx, te, 0, ad);
      
      try {
          lookup_aggrdecl(te, 0, name);
          CT_OK();
      } catch {
          case &Dict::Absent:
              CT_FAILM("Recursive struct should be in environment");
      }
  }

  void test_tc_struct_redecl() {
      tenv_t te = Tcenv::tc_init();
      tc_context_t ctx = Tc::tc_init();
      qvar_t name = mk_qvar("S");
      
      // struct S;
      aggrdecl_t fwd = new Aggrdecl {
          .kind = StructA,
          .sc = Public,
          .name = name,
          .tvs = NULL,
          .impl = NULL,
          .attributes = NULL,
          .expected_mem_kind = false
      };
      
      // struct S { int x; };
      aggrfield_t f1 = new Aggrfield(new ((string_t)strdup((string_t)"x")), empty_tqual(0), int_type(Signed, Int_sz), NULL, NULL, NULL);
      struct AggrdeclImpl impl = {
          .exist_vars = NULL,
          .qual_bnd = NULL,
          .fields = new List(f1, NULL),
          .tagged = false,
          .effconstr = NULL
      };
      aggrdecl_t def = new Aggrdecl {
          .kind = StructA,
          .sc = Public,
          .name = name,
          .tvs = NULL,
          .impl = new impl,
          .attributes = NULL,
          .expected_mem_kind = false
      };

      tc(ctx, te, false, new List(new_decl(new Aggr_d(fwd), 0), new List(new_decl(new Aggr_d(def), 0), NULL)));
      
      try {
          aggrdecl_t @ad = lookup_aggrdecl(te, 0, name);
          CT_ASSERT((*ad)->impl != NULL); // Should be defined now
          CT_OK();
      } catch {
          case &Dict::Absent:
              CT_FAILM("Struct S should be in environment");
      }
  }

  void test_tc_struct_mutual_recursive() {
      tenv_t te = Tcenv::tc_init();
      tc_context_t ctx = Tc::tc_init();
      qvar_t nameA = mk_qvar("A");
      qvar_t nameB = mk_qvar("B");
      
      // struct A;
      aggrdecl_t fwdA = new Aggrdecl {
          .kind = StructA, .sc = Public, .name = nameA, .tvs = NULL, .impl = NULL, .attributes = NULL, .expected_mem_kind = false
      };
      // struct B;
      aggrdecl_t fwdB = new Aggrdecl {
          .kind = StructA, .sc = Public, .name = nameB, .tvs = NULL, .impl = NULL, .attributes = NULL, .expected_mem_kind = false
      };
      
      // struct A { B *b; };
      type_t ptrB = star_type(strctq(nameB), heap_rgn_type, al_qual_type, empty_tqual(0), false_type, false_type);
      aggrfield_t fA = new Aggrfield(new ((string_t)strdup((string_t)"b")), empty_tqual(0), ptrB, NULL, NULL, NULL);
      struct AggrdeclImpl implA = { .exist_vars = NULL, .qual_bnd = NULL, .fields = new List(fA, NULL), .tagged = false, .effconstr = NULL };
      aggrdecl_t defA = new Aggrdecl {
          .kind = StructA, .sc = Public, .name = nameA, .tvs = NULL, .impl = new implA, .attributes = NULL, .expected_mem_kind = false
      };
      
      // struct B { A *a; };
      type_t ptrA = star_type(strctq(nameA), heap_rgn_type, al_qual_type, empty_tqual(0), false_type, false_type);
      aggrfield_t fB = new Aggrfield(new ((string_t)strdup((string_t)"a")), empty_tqual(0), ptrA, NULL, NULL, NULL);
      struct AggrdeclImpl implB = { .exist_vars = NULL, .qual_bnd = NULL, .fields = new List(fB, NULL), .tagged = false, .effconstr = NULL };
      aggrdecl_t defB = new Aggrdecl {
          .kind = StructA, .sc = Public, .name = nameB, .tvs = NULL, .impl = new implB, .attributes = NULL, .expected_mem_kind = false
      };
      
      list_t<decl_t> decls = new List(new_decl(new Aggr_d(fwdA), 0),
                             new List(new_decl(new Aggr_d(fwdB), 0),
                             new List(new_decl(new Aggr_d(defA), 0),
                             new List(new_decl(new Aggr_d(defB), 0), NULL))));
                             
      tc(ctx, te, false, decls);
      CT_OK();
  }

  void test_tc_union_tagged() {
      tenv_t te = Tcenv::tc_init();
      tc_context_t ctx = Tc::tc_init();
      qvar_t name = mk_qvar("U");
      
      // tagged union U { int i; float f; };
      aggrfield_t f1 = new Aggrfield(new ((string_t)strdup((string_t)"i")), empty_tqual(0), int_type(Signed, Int_sz), NULL, NULL, NULL);
      aggrfield_t f2 = new Aggrfield(new ((string_t)strdup((string_t)"f")), empty_tqual(0), float_type, NULL, NULL, NULL);
      
      struct AggrdeclImpl impl = {
          .exist_vars = NULL,
          .qual_bnd = NULL,
          .fields = new List(f1, new List(f2, NULL)),
          .tagged = true, // TAGGED
          .effconstr = NULL
      };
      
      aggrdecl_t ad = new Aggrdecl {
          .kind = UnionA, // UNION
          .sc = Public,
          .name = name,
          .tvs = NULL,
          .impl = new impl,
          .attributes = NULL,
          .expected_mem_kind = false
      };
      
      tc(ctx, te, false, new List(new_decl(new Aggr_d(ad), 0), NULL));
      
      try {
          aggrdecl_t @ad_res = lookup_aggrdecl(te, 0, name);
          CT_ASSERT((*ad_res)->impl->tagged);
          CT_OK();
      } catch {
          case &Dict::Absent:
              CT_FAILM("Union U should be in environment");
      }
  }

  tvar_t mk_tvar(const char *s) {
      return new Absyn::Tvar(new ((string_t)strdup((string_t)s)), -1, new Absyn::Eq_kb(&Kinds::mk), NULL);
  }

  void test_tc_struct_generic() {
      tenv_t te = Tcenv::tc_init();
      tc_context_t ctx = Tc::tc_init();
      qvar_t name = mk_qvar("Box");
      
      // struct Box<`a> { `a val; };
      tvar_t ta = mk_tvar("a");
      // Give identity for alpha-conversion check
      ta->identity = 1; 
      
      aggrfield_t f1 = new Aggrfield(new ((string_t)strdup((string_t)"val")), empty_tqual(0), var_type(ta), NULL, NULL, NULL);
      
      struct AggrdeclImpl impl = {
          .exist_vars = NULL,
          .qual_bnd = NULL,
          .fields = new List(f1, NULL),
          .tagged = false,
          .effconstr = NULL
      };
      
      aggrdecl_t ad = new Aggrdecl {
          .kind = StructA,
          .sc = Public,
          .name = name,
          .tvs = new List(ta, NULL),
          .impl = new impl,
          .attributes = NULL,
          .expected_mem_kind = false
      };
      
      tcAggrdecl(ctx, te, 0, ad);
      
      try {
          aggrdecl_t @res = lookup_aggrdecl(te, 0, name);
          // Check that tvars are preserved
          CT_ASSERT((*res)->tvs != NULL);
          CT_OK();
      } catch {
          case &Dict::Absent:
              CT_FAILM("Generic struct Box<`a> should be in environment");
      }
  }

  void test_tc_struct_bitfield() {
      tenv_t te = Tcenv::tc_init();
      tc_context_t ctx = Tc::tc_init();
      qvar_t name = mk_qvar("Bits");
      
      // struct Bits { int x : 3; };
      exp_t width = int_exp(Signed, 3, 0);
      aggrfield_t f1 = new Aggrfield(new ((string_t)strdup((string_t)"x")), empty_tqual(0), int_type(Signed, Int_sz), width, NULL, NULL);
      
      struct AggrdeclImpl impl = {
          .exist_vars = NULL,
          .qual_bnd = NULL,
          .fields = new List(f1, NULL),
          .tagged = false,
          .effconstr = NULL
      };
      
      aggrdecl_t ad = new Aggrdecl {
          .kind = StructA,
          .sc = Public,
          .name = name,
          .tvs = NULL,
          .impl = new impl,
          .attributes = NULL,
          .expected_mem_kind = false
      };
      
      tcAggrdecl(ctx, te, 0, ad);
      
      try {
          aggrdecl_t @res = lookup_aggrdecl(te, 0, name);
          // Verify width is present
          CT_ASSERT((*res)->impl->fields->hd->width != NULL);
          CT_OK();
      } catch {
          case &Dict::Absent:
              CT_FAILM("Struct Bits should be in environment");
      }
  }

  void test_tc_var_attribute() {
      tenv_t te = Tcenv::tc_init();
      tc_context_t ctx = Tc::tc_init();
      qvar_t name = mk_qvar("aligned_var");
      
      // int x __attribute__((aligned(4)));
      vardecl_t vd = new_vardecl(0, name, int_type(Signed, Int_sz), NULL, NULL);
      vd->sc = Public;
      // Attributes are a list
      vd->attributes = new List(new Absyn::Aligned_att(int_exp(Signed, 4, 0)), NULL);
      
      tc(ctx, te, false, new List(new_decl(new Var_d(vd), 0), NULL));
      
      try {
          binding_t b = lookup_ordinary_global(te, 0, name, false);
          // Just check it exists and didn't crash; attributes are checked during tcVardecl
          CT_OK();
      } catch {
          case &Dict::Absent:
              CT_FAILM("Aligned var should be in environment");
      }
  }

  void test_tc_func_varargs() {
      tenv_t te = Tcenv::tc_init();
      tc_context_t ctx = Tc::tc_init();
      qvar_t name = mk_qvar("my_printf");
      
      // void my_printf(const char *fmt, ...);
      // Arg: const char *fmt
      type_t fmt_type = star_type(char_type, heap_rgn_type, al_qual_type, const_tqual(0), true_type, false_type);
      var_opt_t fmt_opt = NULL;
      
      struct FnInfo info = {
          .tvars = NULL,
          .effect = NULL,
          .ret_tqual = empty_tqual(0),
          .ret_type = void_type,
          .args = new List(new $(fmt_opt, empty_tqual(0), fmt_type), NULL),
          .c_varargs = true, // VARARGS
          .cyc_varargs = NULL,
          .qual_bnd = NULL,
          .attributes = NULL,
          .checks_clause = NULL,
          .checks_assn = NULL,
          .requires_clause = NULL,
          .requires_assn = NULL,
          .ensures_clause = NULL,
          .ensures_assn = NULL,
          .throws_clause = NULL,
          .throws_assn = NULL,
          .return_value = NULL,
          .arg_vardecls = NULL, // Usually populated by parser/binding
          .effconstr = NULL
      };
      
      // We need a body or make it extern. Let's make it extern.
      fndecl_t fd = new Fndecl {
          .sc = Extern,
          .is_inline = false,
          .name = name,
          .body = skip_stmt(0),
          .i = info,
          .cached_type = NULL,
          .param_vardecls = new Opt(NULL),
          .fn_vardecl = NULL,
          .orig_scope = Extern,
          .escapes = false
      };
      
      tc(ctx, te, false, new List(new_decl(new Fn_d(fd), 0), NULL));
      
      try {
          binding_t b = lookup_ordinary_global(te, 0, name, false);
          CT_OK();
      } catch {
          case &Dict::Absent:
              CT_FAILM("Varargs function should be in environment");
      }
  }

