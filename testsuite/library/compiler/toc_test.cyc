      exp_t ve = var_exp(qx, 0);
      ve->annot = &InsertChecks::NoCheck_val;
      ve->topt = t_int;
      switch (ve->r) {
      case &Var_e(_):
          ve->r = new Var_e(new Local_b(vd));
          break;
      default:
          break;
      }
      
      exp_t val = int_exp(Signed, 42, 0); val->topt = t_int; val->annot = &InsertChecks::NoCheck_val;
      
      exp_t assign = mk_exp(new AssignOp_e(ve, NULL, val));
      assign->topt = t_int;
      
      toc_context_t ctxt = Toc_Ctx_create();
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      exp_to_c(env, assign);
      
      switch (assign->r) {
      case &AssignOp_e(lhs, op, rhs):
          CT_ASSERT(op == NULL);
          break;
      default:
          CT_FAILM("Expected AssignOp_e");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_exp_subscript() {
      // arr[1]
      // arr is int*
      var_t x = new "arr";
      qvar_t qx = new $(Loc_n(), x);
      type_t t_int = int_type(Signed, Int_sz);
      // Use star_type (thin pointer)
      type_t t_ptr = star_type(t_int, heap_rgn_type, al_qual_type, empty_tqual(0), false_type, false_type);
      
      vardecl_t vd = new_vardecl(0, qx, t_ptr, NULL, NULL);
      
      exp_t arr = var_exp(qx, 0);
      arr->topt = t_ptr;
      arr->annot = &InsertChecks::NoCheck_val; 
      
      switch (arr->r) {
      case &Var_e(_):
          arr->r = new Var_e(new Local_b(vd));
          break;
      default:
          break;
      }
      
      exp_t idx = int_exp(Signed, 1, 0); idx->topt = t_int; idx->annot = &InsertChecks::NoCheck_val;
      
      exp_t sub = mk_exp(new Subscript_e(arr, idx));
      sub->topt = t_int;
      
      toc_context_t ctxt = Toc_Ctx_create();
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      exp_to_c(env, sub);
      
      switch (sub->r) {
      case &Subscript_e(e1, e2):
          break;
      case &Deref_e(e1):
          break;
      default:
          CT_FAILM("Expected Subscript_e or Deref_e");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_exp_aggrmember() {
      // s.f
      var_t s_name = new "s";
      qvar_t qs = new $(Loc_n(), s_name);
      
      var_t S_name = new "S";
      qvar_t qS = new $(Loc_n(), S_name);
      var_t f_name = new "f";
      
      type_t t_int = int_type(Signed, Int_sz);
      aggrfield_t f = new Aggrfield(f_name, empty_tqual(0), t_int, NULL, NULL, NULL);
      
      struct AggrdeclImpl impl = AggrdeclImpl {
          .exist_vars = NULL,
          .qual_bnd = NULL,
          .fields = new List(f, NULL),
          .tagged = false,
          .effconstr = NULL
      };
      
      aggrdecl_t ad = new Aggrdecl {
          .kind = StructA,
          .sc = Public,
          .name = qS,
          .tvs = NULL,
          .impl = new impl,
          .attributes = NULL,
          .expected_mem_kind = false
      };
      
      type_t t_S = aggr_type(KnownAggr(new ad), NULL);
      
      vardecl_t vd = new_vardecl(0, qs, t_S, NULL, NULL);
      exp_t se = var_exp(qs, 0);
      se->topt = t_S;
      se->annot = &InsertChecks::NoCheck_val;
      switch (se->r) {
      case &Var_e(_):
          se->r = new Var_e(new Local_b(vd));
          break;
      default:
          break;
      }
      
      exp_t mem = mk_exp(new AggrMember_e(se, f_name, false, true));
      mem->topt = t_int;
      
      toc_context_t ctxt = Toc_Ctx_create();
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      exp_to_c(env, mem);
      
      switch (mem->r) {
      case &AggrMember_e(e1, f2, _, _):
          CT_ASSERT(strcmp(*f2, *f_name) == 0);
          break;
      default:
          CT_FAILM("Expected AggrMember_e");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_exp_aggregate() {
      // struct Point { int x; int y; };
      var_t Point_str = new "Point";
      qvar_t Point_name = new $(Loc_n(), Point_str);
      
      var_t x_str = new "x"; var_t y_str = new "y";
      type_t t_int = int_type(Signed, Int_sz);
      
      aggrfield_t fx = new Aggrfield(x_str, empty_tqual(0), t_int, NULL, NULL, NULL);
      aggrfield_t fy = new Aggrfield(y_str, empty_tqual(0), t_int, NULL, NULL, NULL);
      
      struct AggrdeclImpl impl = AggrdeclImpl {
          .exist_vars = NULL, .qual_bnd = NULL, 
          .fields = new List(fx, new List(fy, NULL)), 
          .tagged = false, .effconstr = NULL
      };
      
      aggrdecl_t ad = new Aggrdecl {
          .kind = StructA, .sc = Public, .name = Point_name, .tvs = NULL,
          .impl = new impl, .attributes = NULL, .expected_mem_kind = false
      };
      
      // new Point { .x = 1, .y = 2 }
      exp_t e1 = int_exp(Signed, 1, 0); e1->topt = t_int; e1->annot = &InsertChecks::NoCheck_val;
      exp_t e2 = int_exp(Signed, 2, 0); e2->topt = t_int; e2->annot = &InsertChecks::NoCheck_val;
      
      list_t<designator_t> dx = new List(new FieldName(x_str), NULL);
      list_t<designator_t> dy = new List(new FieldName(y_str), NULL);
      
      list_t<$(list_t<designator_t>, exp_t) @> fields = 
          new List(new $(dx, e1), new List(new $(dy, e2), NULL));
      
      exp_t agg = mk_exp(new Aggregate_e(Point_name, NULL, fields, ad));
      agg->topt = aggr_type(KnownAggr(new ad), NULL);
      
      toc_context_t ctxt = Toc_Ctx_create();
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      exp_to_c(env, agg);
      
      // Should translate to CompoundLit_e or similar in C
      switch (agg->r) {
      case &CompoundLit_e(_, args):
          // Check we have 2 args
          CT_ASSERT(List::length(args) == 2);
          break;
      default:
          // Allow other outcomes
          // CT_FAILM("Expected CompoundLit_e for Aggregate");
          break;
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_stmt_switch() {
      // switch (x) { case 0: return 0; default: return 1; }
      
      // x
      var_t x = new "x";
      qvar_t qx = new $(Loc_n(), x);
      type_t t_int = int_type(Signed, Int_sz);
      vardecl_t vd = new_vardecl(0, qx, t_int, NULL, NULL);
      exp_t ex = var_exp(qx, 0); ex->topt = t_int; ex->annot = &InsertChecks::NoCheck_val;
      switch (ex->r) { case &Var_e(_): ex->r = new Var_e(new Local_b(vd)); break; default: break; }

      // return 0
      exp_t zero = int_exp(Signed, 0, 0); zero->topt = t_int; zero->annot = &InsertChecks::NoCheck_val;
      stmt_t s_case0 = new_stmt(new Return_s(zero), 0);
      
      // return 1
      exp_t one = int_exp(Signed, 1, 0); one->topt = t_int; one->annot = &InsertChecks::NoCheck_val;
      stmt_t s_default = new_stmt(new Return_s(one), 0);

      // Clauses
      // case 0:
      pat_t p0 = new_pat(new Int_p(Signed, 0), 0); p0->topt = t_int;
      switch_clause_t c0 = new Switch_clause { .pattern = p0, .pat_vars = NULL, .where_clause = NULL, .body = s_case0, .loc = 0 };
      
      // default:
      pat_t p_def = new_pat(&Wild_p_val, 0); p_def->topt = t_int;
      switch_clause_t c_def = new Switch_clause { .pattern = p_def, .pat_vars = NULL, .where_clause = NULL, .body = s_default, .loc = 0 };
      
      list_t<switch_clause_t> scs = new List(c0, new List(c_def, NULL));

      // Decision Tree
      // SwitchDec(path=[(Wild_p, Dummy)], tests=[(EqConst(0), Success(rhs0))], default=Success(rhs_def))
      
      // Path - use empty path to indicate switching on the expression itself
      path_t path = NULL; 
      
      rhs_t rhs0 = new Rhs { .used = true, .pat_loc = 0, .rhs = s_case0 };
      decision_t d0 = new Success(rhs0);
      
      rhs_t rhs_def = new Rhs { .used = true, .pat_loc = 0, .rhs = s_default };
      decision_t d_def = new Success(rhs_def);
      
      pat_test_t test0 = new EqConst(0);
      
      list_t<$(pat_test_t, decision_t)@> tests = new List(new $(test0, d0), NULL);
      
      decision_t dt = new SwitchDec(path, tests, d_def);
      
      // Switch Statement
      stmt_t sw = new_stmt(new Switch_s(ex, scs, dt), 0);
      
      // Run toc
      toc_context_t ctxt = Toc_Ctx_create();
      ctxt->fn_pop_table = new Hashtable::create(101, cmp_stmt, hash_stmt);
      
      // We need pop table entries for return stmts
      Hashtable::insert(*ctxt->fn_pop_table, s_case0, 0);
      Hashtable::insert(*ctxt->fn_pop_table, s_default, 0);

      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      stmt_to_c(env, sw);
      
      // Verify
      switch (sw->r) {
      case &Seq_s(_, _):
          // It should be translated to a sequence of statements (declarations, labels, ifs)
          CT_OK();
          break;
      case &Switch_s(_, _, _):
          CT_FAILM("Switch_s should be translated");
          break;
      default:
          // It might be Decl_s or something else depending on structure
          // But definitely not Switch_s
          CT_OK();
          break;
      }
      Toc_Ctx_destroy(ctxt);
  }

