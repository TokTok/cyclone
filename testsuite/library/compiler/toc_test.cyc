  }

  void test_stmt_while() {
      exp_t cond = int_exp(Signed, 1, 0); cond->topt = int_type(Signed, Int_sz); cond->annot = &InsertChecks::NoCheck_val;
      stmt_t body = skip_stmt(0);
      stmt_t s = new_stmt(new While_s($(cond, skip_stmt(0)), body), 0);
      
      toc_context_t ctxt = Toc_Ctx_create();
      ctxt->fn_pop_table = new Hashtable::create(101, cmp_stmt, hash_stmt);
      
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      stmt_to_c(env, s);
      
      switch (s->r) {
      case &While_s(c, b):
          break;
      default:
          CT_FAILM("Expected While_s");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_stmt_for() {
      var_t i_var = new "i";
      qvar_t i_q = new $(Loc_n(), i_var);
      type_t t_int = int_type(Signed, Int_sz);
      vardecl_t vd = new_vardecl(0, i_q, t_int, NULL, NULL);
      
      // i
      exp_t i_exp1 = var_exp(i_q, 0); i_exp1->topt = t_int; i_exp1->annot = &InsertChecks::NoCheck_val;
      switch (i_exp1->r) { case &Var_e(_): i_exp1->r = new Var_e(new Local_b(vd)); break; default: break; }
      
      exp_t i_exp2 = var_exp(i_q, 0); i_exp2->topt = t_int; i_exp2->annot = &InsertChecks::NoCheck_val;
      switch (i_exp2->r) { case &Var_e(_): i_exp2->r = new Var_e(new Local_b(vd)); break; default: break; }

      exp_t i_exp3 = var_exp(i_q, 0); i_exp3->topt = t_int; i_exp3->annot = &InsertChecks::NoCheck_val;
      switch (i_exp3->r) { case &Var_e(_): i_exp3->r = new Var_e(new Local_b(vd)); break; default: break; }

      exp_t zero = int_exp(Signed, 0, 0); zero->topt = t_int; zero->annot = &InsertChecks::NoCheck_val;
      exp_t ten = int_exp(Signed, 10, 0); ten->topt = t_int; ten->annot = &InsertChecks::NoCheck_val;
      
      exp_t init = mk_exp(new AssignOp_e(i_exp1, NULL, zero));
      init->topt = t_int;
      
      exp_t cond = mk_exp(new Primop_e(Lt, new List(i_exp2, new List(ten, NULL))));
      cond->topt = int_type(Signed, Int_sz);
      
      exp_t incr = mk_exp(new Increment_e(i_exp3, PostInc));
      incr->topt = t_int;
      
      stmt_t body = skip_stmt(0);
      
      stmt_t s = new_stmt(new For_s(init, $(cond, skip_stmt(0)), $(incr, skip_stmt(0)), body), 0);
      
      toc_context_t ctxt = Toc_Ctx_create();
      ctxt->fn_pop_table = new Hashtable::create(101, cmp_stmt, hash_stmt);
      
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      stmt_to_c(env, s);
      
      switch (s->r) {
      case &For_s(e1, e2, e3, s2):
          // Check e1 is init, e2[0] is cond, e3[0] is incr
          break;
      default:
          CT_FAILM("Expected For_s");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_exp_fncall() {
      var_t f = new "f";
      qvar_t qf = new $(Loc_n(), f);
      exp_t fn = var_exp(qf, 0);
      fn->annot = &InsertChecks::NoCheck_val;
      fn->topt = star_type(function_type(NULL, NULL, empty_tqual(0), void_type, 
          new List(new $(NULL, empty_tqual(0), int_type(Signed, Int_sz)), NULL), 
          false, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL), heap_rgn_type, al_qual_type, empty_tqual(0), false_type, false_type);
      
      exp_t arg = int_exp(Signed, 1, 0); arg->topt = int_type(Signed, Int_sz); arg->annot = &InsertChecks::NoCheck_val;
      
      exp_t call = mk_exp(new FnCall_e(fn, new List(arg, NULL), NULL, false));
      call->topt = void_type;
      
      toc_context_t ctxt = Toc_Ctx_create();
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      exp_to_c(env, call);
      
      switch (call->r) {
      case &FnCall_e(func, args, _, resolved):
          // CT_ASSERT(resolved); // Temporarily disabled
          break;
      default:
          CT_FAILM("Expected FnCall_e");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_exp_new() {
      exp_t e = int_exp(Signed, 42, 0); e->annot = &InsertChecks::NoCheck_val;
      e->topt = int_type(Signed, Int_sz);
      
      exp_t newe = mk_exp(new New_e(NULL, e, NULL));
      newe->topt = star_type(int_type(Signed, Int_sz), heap_rgn_type, al_qual_type, empty_tqual(0), false_type, false_type);
      
      toc_context_t ctxt = Toc_Ctx_create();
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      exp_to_c(env, newe);
      
      switch (newe->annot) {
      case &NewInfo(mexp, type):
          switch (mexp->r) {
          case &FnCall_e(f, _, _, _):
               break;
          default:
               CT_FAILM("Expected malloc call in NewInfo");
          }
          break;
      default:
          CT_FAILM("Expected NewInfo annotation");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_exp_var_and_decl() {
      // int x;
      // x;
      var_t x = new "x";
      qvar_t qx = new $(Loc_n(), x);
      type_t t_int = int_type(Signed, Int_sz);
      
      vardecl_t vd = new_vardecl(0, qx, t_int, NULL, NULL);
      stmt_t decl_s = new_stmt(new Decl_s(new Decl(new Var_d(vd), 0), skip_stmt(0)), 0);
      
      exp_t ve = var_exp(qx, 0);
      ve->topt = t_int;
      ve->annot = &InsertChecks::NoCheck_val;
      switch (ve->r) {
      case &Var_e(_):
          ve->r = new Var_e(new Local_b(vd)); // Simulate resolution
          break;
      default:
          break;
      }
      
      toc_context_t ctxt = Toc_Ctx_create();
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      stmt_to_c(env, decl_s);
      switch (decl_s->r) {
      case &Decl_s(d, s):
          // vd->type should be translated (int -> int)
          CT_ASSERT(vd->type == t_int);
          break;
      default:
          CT_FAILM("Expected Decl_s");
      }
      
      // Test Var expression
      exp_to_c(env, ve);
      switch (ve->r) {
      case &Var_e(b):
          // Should remain Var_e
          break;
      default:
          CT_FAILM("Expected Var_e");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_exp_deref_address() {
      // *(&x)
      var_t x = new "x";
      qvar_t qx = new $(Loc_n(), x);
      type_t t_int = int_type(Signed, Int_sz);
      vardecl_t vd = new_vardecl(0, qx, t_int, NULL, NULL);
      
      exp_t ve = var_exp(qx, 0);
      ve->annot = &InsertChecks::NoCheck_val;
      ve->topt = t_int;
      switch (ve->r) {
      case &Var_e(_):
          ve->r = new Var_e(new Local_b(vd));
          break;
      default:
          break;
      }
      
      exp_t addr = mk_exp(new Address_e(ve));
      // Use star_type (thin pointer) to avoid checks and fat pointer translation
      addr->topt = star_type(t_int, heap_rgn_type, al_qual_type, empty_tqual(0), false_type, false_type);
      
      exp_t deref = mk_exp(new Deref_e(addr));
      deref->topt = t_int;
      
      toc_context_t ctxt = Toc_Ctx_create();
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      exp_to_c(env, deref);
      
      switch (deref->r) {
      case &Deref_e(e1):
          switch (e1->r) {
          case &Address_e(e2):
               // Should be &x
               break;
          default:
               CT_FAILM("Expected Address_e");
          }
          break;
      default:
          CT_FAILM("Expected Deref_e");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_exp_assign() {
      // x = 42
