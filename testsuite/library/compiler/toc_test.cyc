#include "cyclone/testsuite/cyctest.h"
#include "cyclone/library/compiler/absyn.h"
#include "cyclone/library/compiler/toc.h"
#include "cyclone/library/compiler/tcpat.h"
#include "cyclone/library/compiler/insert_checks.h"
#include "cyclone/library/std/string.h"
#include "cyclone/library/std/list.h"
#include "cyclone/library/std/hashtable.h"

using Absyn;
using Toc;
using Core;
using List;
using InsertChecks;
using Tcpat;

CT_SUITE_BEGIN(Toc)

  void begin() {
  }

  void end() {
  }

  exp_t mk_exp(raw_exp_t r) {
      exp_t e = new_exp(r, 0);
      e->annot = &InsertChecks::NoCheck_val;
      return e;
  }

  int hash_stmt(stmt_t s) {
      return (int)s;
  }
  
  int cmp_stmt(stmt_t s1, stmt_t s2) {
      if (s1 == s2) return 0;
      return (s1 < s2) ? -1 : 1;
  }

  void test_int_type() {
    toc_context_t ctxt = Toc_Ctx_create();
    type_t t = int_type(Signed, Int_sz);
    type_t res = typ_to_c(ctxt, t);
    CT_ASSERT(t == res);
    Toc_Ctx_destroy(ctxt);
  }
  
  void test_thin_ptr() {
      toc_context_t ctxt = Toc_Ctx_create();
      type_t elt = int_type(Signed, Int_sz);
      type_t t = star_type(elt, heap_rgn_type, al_qual_type, empty_tqual(0), false_type, false_type);
      type_t res = typ_to_c(ctxt, t);
      
      switch (res) {
      case &PointerType(pi):
          CT_ASSERT(pi.elt_type == elt); 
          break;
      default:
          CT_FAILM("Expected PointerType");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_fat_ptr() {
      toc_context_t ctxt = Toc_Ctx_create();
      type_t elt = int_type(Signed, Int_sz);
      type_t t = fatptr_type(elt, heap_rgn_type, al_qual_type, empty_tqual(0), false_type, false_type);
      type_t res = typ_to_c(ctxt, t);
      
      switch (res) {
      case &AppType(&AggrCon(info), _):
          switch (info) {
          case {.UnknownAggr = v}:
               let $(k, n, _) = v;
               let &$(ns, v_str) = n;
               CT_ASSERT(strcmp(*v_str, "_fat_ptr") == 0);
               break;
          default:
             CT_FAILM("Expected UnknownAggr");
          }
          break;
      default:
           CT_FAILM("Expected AppType AggrCon for fat pointer");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_temp_var() {
      toc_context_t ctxt = Toc::Toc_Ctx_create();
      qvar_t v1 = Toc::temp_var(ctxt);
      qvar_t v2 = Toc::temp_var(ctxt);
      
      let &$(ns1, n1) = v1;
      let &$(ns2, n2) = v2;
      
      CT_ASSERT(strcmp(*n1, *n2) != 0);
      CT_ASSERT(strncmp(*n1, "_tmp", 4) == 0);
      Toc::Toc_Ctx_destroy(ctxt);
  }

  void test_collapse_qvar() {
      toc_context_t ctxt = Toc_Ctx_create();
      var_t foo_str = new "Foo";
      qvar_t foo_name = new $(Loc_n(), foo_str);
      var_t bar_str = new "Bar";
      qvar_t bar_name = new $(Loc_n(), bar_str);
      
      datatypedecl_t dd = new Datatypedecl {
          .sc = Public,
          .name = foo_name,
          .tvs = NULL,
          .fields = NULL,
          .is_extensible = false
      };
      
      datatypefield_t df = new Datatypefield {
          .name = bar_name,
          .typs = NULL,
          .loc = 0,
          .sc = Public
      };

      datatype_field_info_t dfi = KnownDatatypefield(dd, df);
      type_t t = datatype_field_type(dfi, NULL);
      
      type_t res = typ_to_c(ctxt, t);
      
      switch (res) {
      case &AppType(&AggrCon(info), _):
           switch (info) {
           case {.UnknownAggr = v}:
               let $(k, n, _) = v;
               let &$(ns, v_str) = n;
               CT_ASSERT(strcmp(*v_str, "Bar_Foo_struct") == 0);
               break;
           default:
               CT_FAILM("Expected UnknownAggr");
           }
           break;
      default:
           CT_FAILM("Expected AppType AggrCon");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_array_type() {
      toc_context_t ctxt = Toc_Ctx_create();
      type_t elt = int_type(Signed, Int_sz);
      exp_t ten = int_exp(Signed, 10, 0);
      type_t t = array_type(elt, empty_tqual(0), ten, true_type, 0);
      
      type_t res = typ_to_c(ctxt, t);
      
      switch (res) {
      case &ArrayType(ai):
          CT_ASSERT(ai.elt_type == elt);
          CT_ASSERT(ai.zero_term == false_type);
          break;
      default:
          CT_FAILM("Expected ArrayType");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_var_type() {
      toc_context_t ctxt = Toc_Ctx_create();
      var_t a = new "a";
      tvar_t tv = new Tvar {
          .name = a,
          .identity = 0,
          .kind = new Eq_kb(new Kind{ .kind = BoxKind, .aliashint = NoHint }),
          .aquals_bound = NULL
      };
      type_t t = var_type(tv);
      type_t res = typ_to_c(ctxt, t);
      
      switch (res) {
      case &PointerType(pi):
          switch (pi.elt_type) {
          case &AppType(&VoidCon, _):
              CT_OK();
              break;
          default:
              CT_FAILM("Expected void*");
          }
          break;
      default:
          CT_FAILM("Expected PointerType");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_void_con() {
      toc_context_t ctxt = Toc_Ctx_create();
      type_t t = void_type;
      type_t res = typ_to_c(ctxt, t);
      CT_ASSERT(t == res);
      Toc_Ctx_destroy(ctxt);
  }

  void test_exp_to_c_int() {
      exp_t e = int_exp(Signed, 42, 0);
      e->annot = &InsertChecks::NoCheck_val;
      e->topt = int_type(Signed, Int_sz);
      
      toc_context_t ctxt = Toc_Ctx_create();
      
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      exp_to_c(env, e);
      
      switch (e->r) {
      case &Const_e(c):
          switch (c) {
          case {.Int_c = $(s, i)}:
              CT_ASSERT(i == 42);
              break;
          default:
              CT_FAILM("Expected Int_c");
          }
          break;
      default:
          CT_FAILM("Expected Const_e");
      }
      
      type_t t = (type_t)e->topt;
      CT_ASSERT(t == int_type(Signed, Int_sz));
      Toc_Ctx_destroy(ctxt);
  }

  void test_stmt_to_c_skip() {
      stmt_t s = skip_stmt(0);
      
      toc_context_t ctxt = Toc_Ctx_create();
      
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      stmt_to_c(env, s);
      
      switch (s->r) {
      case &Skip_s:
          CT_OK();
          break;
      default:
          CT_FAILM("Expected Skip_s");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_exp_to_c_cast() {
      exp_t e = int_exp(Signed, 42, 0); e->annot = &InsertChecks::NoCheck_val;
      type_t t_int = int_type(Signed, Int_sz);
      e->topt = t_int;
      
      type_t t_short = int_type(Signed, Short_sz);
      
      exp_t cast_e = mk_exp(new Cast_e(t_short, e, true, No_coercion));
      cast_e->topt = t_short;
      
      toc_context_t ctxt = Toc_Ctx_create();
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      exp_to_c(env, cast_e);
      
      switch (cast_e->r) {
      case &Cast_e(t, e2, _, _):
          CT_ASSERT(t == t_short);
          switch (e2->r) {
          case &Const_e(c):
               switch (c) {
               case {.Int_c = $(s, i)}:
                   CT_ASSERT(i == 42);
                   break;
               default:
                   CT_FAILM("Expected Int_c inside cast");
               }
               break;
          default:
               CT_FAILM("Expected Const_e inside cast");
          }
          break;
      default:
          CT_FAILM("Expected Cast_e");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_primop_plus_int() {
      exp_t e1 = int_exp(Signed, 1, 0); e1->topt = int_type(Signed, Int_sz); e1->annot = &InsertChecks::NoCheck_val;
      exp_t e2 = int_exp(Signed, 2, 0); e2->topt = int_type(Signed, Int_sz); e2->annot = &InsertChecks::NoCheck_val;
      exp_t e = mk_exp(new Primop_e(Plus, new List(e1, new List(e2, NULL))));
      e->topt = int_type(Signed, Int_sz);

      toc_context_t ctxt = Toc_Ctx_create();
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      exp_to_c(env, e);
      
      switch (e->r) {
      case &Primop_e(op, args):
          CT_ASSERT(op == Plus);
          break;
      default:
          CT_FAILM("Expected Primop_e");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_stmt_if() {
      exp_t cond = int_exp(Signed, 1, 0); cond->topt = int_type(Signed, Int_sz); cond->annot = &InsertChecks::NoCheck_val;
      stmt_t s1 = skip_stmt(0);
      stmt_t s2 = skip_stmt(0);
      stmt_t s = new_stmt(new IfThenElse_s(cond, s1, s2), 0);
      
      toc_context_t ctxt = Toc_Ctx_create();
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      stmt_to_c(env, s);
      
      switch (s->r) {
      case &IfThenElse_s(c, st1, st2):
          switch (c->r) {
          case &Const_e(cn):
               break;
          default:
               CT_FAILM("Expected Const_e in If condition");
          }
          break;
      default:
          CT_FAILM("Expected IfThenElse_s");
      }
      Toc_Ctx_destroy(ctxt);
  }

  void test_stmt_return() {
      exp_t e = int_exp(Signed, 0, 0); e->topt = int_type(Signed, Int_sz); e->annot = &InsertChecks::NoCheck_val;
      stmt_t s = new_stmt(new Return_s(e), 0);
      
      toc_context_t ctxt = Toc_Ctx_create();
      ctxt->fn_pop_table = new Hashtable::create(101, cmp_stmt, hash_stmt);
      Hashtable::insert(*ctxt->fn_pop_table, s, 0);
      
      region r;
      env_t<`r> env = empty_env(r, ctxt);
      
      stmt_to_c(env, s);
      
      switch (s->r) {
      case &Return_s(e_opt):
          CT_ASSERT(e_opt != NULL);
          break;
      default:
          CT_FAILM("Expected Return_s");
      }
      Toc_Ctx_destroy(ctxt);
  }

